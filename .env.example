# 复制为 .env 后填写，并执行 chmod 600 .env。不要提交 .env，不要把其中内容发到聊天里。

# 本机 Gateway：只能是回环地址
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=18765
# 至少 32 字符随机值：openssl rand -hex 32
LOCAL_BRIDGE_TOKEN=REPLACE_WITH_RANDOM_SECRET

# 项目白名单（scripts/setup-demo.sh 可生成）
PROJECTS_CONFIG=./config/projects.json
# 任务数据库与日志目录，默认 ~/.xiaozhi-codex-bridge（仓库之外）
# BRIDGE_DATA_DIR=

# 1 = 使用 Mock Codex（无账号/CI）；0 = 真实 Codex SDK
CODEX_MOCK=0
CODEX_TASK_TIMEOUT_MS=600000
CODEX_MAX_QUEUE=10

# 一个接入点 = 一个受信用户/设备组；任务归属与会话按此隔离
BRIDGE_NAMESPACE=default

# 小智控制台 → 智能体 → MCP 设置 → 获取 MCP 接入点（完整 wss 地址，含 token）
XIAOZHI_MCP_ENDPOINT=

LOG_LEVEL=info
